# Server
PORT=3210
HOST=127.0.0.1

# Auth (comma-separated; configuring any token enables Bearer auth on /api and /mcp)
# AIMOCK_TOKEN=change-me
# Also require a token on /mock/* (off by default)
# AIMOCK_REQUIRE_MOCK_AUTH=true

# Database (overrides data/connection.json when set)
# AIMOCK_DB_CLIENT=sqlite | mysql | mssql
# AIMOCK_DB_FILENAME=./data/ai-mock.sqlite
# AIMOCK_DB_HOST=127.0.0.1
# AIMOCK_DB_PORT=3306
# AIMOCK_DB_USER=root
# AIMOCK_DB_PASSWORD=
# AIMOCK_DB_DATABASE=ai_mock
